    <path
        android:fillColor="#9CC0F5"
        android:pathData="M36.9,69.8 h3 a1,1 0 0 1 1,1 v2.5 a1,1 0 0 1 -1,1 h-3 a1,1 0 0 1 -1,-1 v-2.5 a1,1 0 0 1 1,-1 z
            M44.7,69.8 h3 a1,1 0 0 1 1,1 v2.5 a1,1 0 0 1 -1,1 h-3 a1,1 0 0 1 -1,-1 v-2.5 a1,1 0 0 1 1,-1 z
            M52.5,69.8 h3 a1,1 0 0 1 1,1 v2.5 a1,1 0 0 1 -1,1 h-3 a1,1 0 0 1 -1,-1 v-2.5 a1,1 0 0 1 1,-1 z
            M60.3,69.8 h3 a1,1 0 0 1 1,1 v2.5 a1,1 0 0 1 -1,1 h-3 a1,1 0 0 1 -1,-1 v-2.5 a1,1 0 0 1 1,-1 z
            M68.1,69.8 h3 a1,1 0 0 1 1,1 v2.5 a1,1 0 0 1 -1,1 h-3 a1,1 0 0 1 -1,-1 v-2.5 a1,1 0 0 1 1,-1 z" />
    <path
        android:fillColor="#9CC0F5"
        android:pathData="M44.7,77.1 h3 a1,1 0 0 1 1,1 v2.5 a1,1 0 0 1 -1,1 h-3 a1,1 0 0 1 -1,-1 v-2.5 a1,1 0 0 1 1,-1 z
            M52.5,77.1 h3 a1,1 0 0 1 1,1 v2.5 a1,1 0 0 1 -1,1 h-3 a1,1 0 0 1 -1,-1 v-2.5 a1,1 0 0 1 1,-1 z

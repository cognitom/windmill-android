    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- キー。1本のパスにまとめると lint の VectorPath (長すぎるパス) に掛かるので、行ごとに分ける -->
    <path
        android:fillColor="#9CC0F5"
        android:pathData="M36.9,62.5 h3 a1,1 0 0 1 1,1 v2.5 a1,1 0 0 1 -1,1 h-3 a1,1 0 0 1 -1,-1 v-2.5 a1,1 0 0 1 1,-1 z
            M44.7,62.5 h3 a1,1 0 0 1 1,1 v2.5 a1,1 0 0 1 -1,1 h-3 a1,1 0 0 1 -1,-1 v-2.5 a1,1 0 0 1 1,-1 z
            M52.5,62.5 h3 a1,1 0 0 1 1,1 v2.5 a1,1 0 0 1 -1,1 h-3 a1,1 0 0 1 -1,-1 v-2.5 a1,1 0 0 1 1,-1 z
